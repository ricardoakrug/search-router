# Copy to .env and fill the keys for the providers you use (bring your own keys).
# Everything runs locally — your keys never leave your machine.
# Provider API keys (single-tenant 'self')
EXA_API_KEY=
PERPLEXITY_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
XAI_API_KEY=
CONTEXT7_API_KEY=

# Optional shared token between the MCP server and the API (authStub checks it if set)
INTERNAL_API_TOKEN=

# MCP server -> API base URL
SEARCH_API_URL=http://localhost:8787

# API server
PORT=8787
