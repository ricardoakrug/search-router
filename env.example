# Copy to .env and fill the keys for the providers you use (bring your own keys).
# Everything runs locally — your keys never leave your machine.
# Provider API keys (single-tenant 'self')
EXA_API_KEY=
PERPLEXITY_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
XAI_API_KEY=
CONTEXT7_API_KEY=

# Optional shared token between the MCP server and the API (authStub checks it if set)
INTERNAL_API_TOKEN=

# MCP server -> API base URL
SEARCH_API_URL=http://localhost:8787

# API server
PORT=8787

# --- Hardening (all optional; safe defaults shown) ---
# Max request body size in bytes (413 over this)
MAX_BODY_BYTES=65536
# Per-window request cap, keyed by client socket IP; 0 disables. In-memory, single-instance.
RATE_LIMIT_RPM=60
# Set true only when behind a trusted reverse proxy — then the first x-forwarded-for hop
# is used as the client IP. Leave unset/false when directly exposed (header is spoofable).
TRUST_PROXY=false
# Provider HTTP retry/backoff (transient 429/5xx/network only)
HTTP_MAX_RETRIES=2
HTTP_RETRY_BASE_MS=200
# Per-provider circuit breaker
CB_THRESHOLD=5
CB_COOLDOWN_MS=30000
# Logger verbosity (pino): trace|debug|info|warn|error
LOG_LEVEL=info
# Graceful-shutdown drain timeout (ms)
SHUTDOWN_TIMEOUT_MS=10000
